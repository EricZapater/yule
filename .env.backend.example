# =============================================================================
# YULE - Backend Environment Variables (.env.backend)
# =============================================================================

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=yule
DB_SSLMODE=disable

# Or direct DATABASE_URL connection string:
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/yule?sslmode=disable

# API Configuration
PORT=8080
GIN_MODE=release
APP_BASE_URL=https://yule.ericzapater.cat

# Optional Initial Administrator (if omitted, the first registered user becomes admin)
# ADMIN_EMAIL=admin@exemple.cat
# ADMIN_NAME=Administrador

# JWT Security
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_chars

# SMTP Configuration (per a l'enviament de Magic Links per correu)
# Si es deixa en blanc, els Magic Links es mostraran a 'docker compose logs yule-backend'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=el.teu.correu@gmail.com
SMTP_PASSWORD=la_teva_app_password
SMTP_FROM=Yule Amic Invisible <el.teu.correu@gmail.com>

# Timezone
TZ=Europe/Madrid
